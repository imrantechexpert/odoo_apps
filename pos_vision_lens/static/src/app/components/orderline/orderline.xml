<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_vision_lens.Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//ul[hasclass('info-list')]" position="inside">
            <li t-if="this.line.isVisionLens"
                t-attf-class="vision-line-summary w-100 rounded p-2 text-break {{ this.line.visionSummary ? 'text-bg-info bg-opacity-25' : 'text-bg-warning bg-opacity-25' }}">
                <i class="oi me-1" data-icon="visibility" aria-hidden="true"/>
                <t t-if="this.line.visionSummary" t-out="this.line.visionSummary"/>
                <t t-else="">Prescription not set</t>
            </li>
        </xpath>
    </t>
</templates>
