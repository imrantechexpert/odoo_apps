<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form" model="ir.ui.view">
        <field name="name">pos.config.form.inherit.pos.restrict.negative.sale</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='configuration']//div[hasclass('o_settings_container')]" position="inside">
                <setting id="restrict_negative_sale"
                         string="Block out-of-stock sales"
                         help="Stop a sale when the product, or the chosen variant, has no quantity left in this shop. A higher quantity than what is left is blocked as well.">
                    <field name="restrict_negative_sale"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
